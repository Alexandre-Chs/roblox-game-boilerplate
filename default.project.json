{
  "name": "Roblox House Starter",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "$path": "src/shared",
      "Packages": {
        "$path": "Packages"
      },
      "ReplicaClient": {
        "$path": "vendor/Replica/src/ReplicatedStorage/ReplicaClient.luau"
      },
      "ReplicaShared": {
        "$path": "vendor/Replica/src/ReplicatedStorage/ReplicaShared"
      }
    },
    "ReplicatedFirst": {
      "$ignoreUnknownInstances": true,
      "$path": "src/first"
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "$path": "src/server",
      "ServerPackages": {
        "$path": "ServerPackages"
      },
      "ReplicaServer": {
        "$path": "vendor/Replica/src/ServerScriptService/ReplicaServer.luau"
      }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "$path": "src/client"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "$path": "assets/ui"
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "StarterMap": {
        "$path": "assets/world"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 15,
        "Brightness": 2
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    },
    "LocalizationService": {
      "$className": "LocalizationService",
      "$ignoreUnknownInstances": true,
      "$path": "assets/localization"
    }
  }
}
